# Polymarket live trading — copy to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# paper = simulate (default, matches legacy daemon_base_v1 behaviour)
# live  = send real orders to Polymarket CLOB
POLYMARKET_MODE=paper

# EOA private key that SIGNS orders (0x-prefixed 64 hex chars).
# For Polymarket web users this is the key controlling the Magic/proxy wallet;
# export it from the Polymarket profile settings.
POLYMARKET_PRIVATE_KEY=0x...

# Address that HOLDS the funds on Polymarket (the 0x... shown in your profile).
# Different from the EOA above for proxy/Magic wallets.
POLYMARKET_FUNDER=0x...

# 0 = EOA/MetaMask, 1 = Magic/email proxy (Polymarket web default), 2 = browser proxy.
POLYMARKET_SIGNATURE_TYPE=1

# Polygon mainnet chain id.
POLYMARKET_CHAIN_ID=137

# Kill switch: if live mode is on but DRY_RUN=1, orders are logged but NOT posted.
POLYMARKET_DRY_RUN=0

# Risk guards
MAX_DAILY_LOSS_USDC=300
MAX_TRADE_SIZE_USDC=100
KILL_SWITCH_FILE=daemon_state/KILL
